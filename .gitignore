
# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Python build
build/
dist/
*.egg-info/
.eggs/

# Virtual Environment
.venv/
venv/
env/
ENV/

# Python testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter Notebook
.ipynb_checkpoints/

# ==========================================
# ENVIRONMENT & SECRETS
# ==========================================
.env
.env.*
.env.example

.streamlit/secrets.toml

# ==========================================
# DATASET
# ==========================================
# Dataset Roboflow
data/raw/*
data/interim/*
data/processed/*

# OCR annotations and generated splits
data/annotations/*
data/splits/*

# Keep empty directory markers (structure tracking)
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/annotations/detection/
!data/annotations/ocr/
!data/annotations/detection/.gitkeep
!data/annotations/ocr/.gitkeep
!data/splits/.gitkeep

# ==========================================
# MACHINE LEARNING MODELS
# ==========================================
# Pretrained models
models/pretrained/*

# Trained models
models/trained/*

# Keep empty directory markers
!models/pretrained/.gitkeep
!models/trained/.gitkeep

# Model weights
*.pt
*.pth
*.onnx
*.engine
*.h5
*.keras

# ==========================================
# EXPERIMENT OUTPUTS
# ==========================================
outputs/predictions/*
outputs/visualizations/*
outputs/reports/*

# Keep empty directory markers
!outputs/predictions/.gitkeep
!outputs/visualizations/.gitkeep
!outputs/reports/.gitkeep

# Training runs
runs/
wandb/
mlruns/

# ==========================================
# LOGS
# ==========================================
*.log
logs/

# ==========================================
# TEMPORARY FILES
# ==========================================
*.tmp
*.temp
*.bak
*.swp
*.swo

# ==========================================
# OPERATING SYSTEM
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# IDE & EDITOR
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# ==========================================
# STREAMLIT
# ==========================================
.streamlit/cache/
