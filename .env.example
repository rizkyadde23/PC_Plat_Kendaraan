# ALPRO environment template (no secrets)
# Salin file ini menjadi `.env` jika diperlukan konfigurasi lokal.
# Jangan menyimpan kredensial/API key di repository.

# Path konfigurasi (relatif terhadap root proyek atau absolut lokal)
ALPRO_APP_CONFIG=configs/app.yaml
ALPRO_DETECTOR_CONFIG=configs/detector.yaml
ALPRO_PREPROCESSING_CONFIG=configs/preprocessing.yaml

# Runtime
ALPRO_DEVICE=cpu
ALPRO_LOG_LEVEL=INFO
